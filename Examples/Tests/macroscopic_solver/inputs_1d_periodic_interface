# 1D regression test for the macroscopic (dielectric) electromagnetic solver.
#
# A standing wave is set up in a periodic 1D box along z.  The mode is initialised
# through the external magnetic field By(z) = cos(kz) with E = 0 at t = 0, where
# k = p*pi/L.  The box contains TWO dielectrics: epsilon_r = 1.5 for z < 0.5 and
# epsilon_r = 1.0 for z > 0.5, so this exercises the subpixel interface path
# (`interface_function` + `epsilon2`) rather than a uniform medium.
#
# NOTE (2026-11-17 review, N-01): `interface_function` must be written in the
# coordinates WarpX actually uses for 1D, i.e. `z` — for 1D the parser is called as
# (x=0, y=0, z).  This file used to say `x - 0.5`, which is constant in z and only
# "worked" because the node-level builder wrongly read the grid index i as x.
# The boundary condition is periodic (NOT PEC), as the deck below states.

max_step = 60

amr.n_cell = 128
amr.max_grid_size = 128
amr.max_level = 0

geometry.dims = 1
geometry.prob_lo = 0.0
geometry.prob_hi = 1.0

warpx.cfl = 1.0
warpx.abort_on_warning_threshold = high

boundary.field_lo = periodic
boundary.field_hi = periodic

# Macroscopic (dielectric) solver: non-dispersive, lossless medium
algo.em_solver_medium = macroscopic
macroscopic.epsilon = 1.5*epsilon0
macroscopic.mu      = mu0
macroscopic.sigma   = 0
macroscopic.epsilon2 = 1.0*epsilon0
algo.macroscopic_subpixel = 1
warpx.Ex_external_grid_function(x,y,z) = 0.0
warpx.Ey_external_grid_function(x,y,z) = 0.0
warpx.Ez_external_grid_function(x,y,z) = 1.0e-3*cos(2*pi*z)
macroscopic.interface_function(x,y,z) = z - 0.5

# Initialize the p = 2 mode (matches my_constants.p below) through B (E = 0).
my_constants.L  = 1.0
my_constants.p  = 2
my_constants.kz = p*pi/L

warpx.B_ext_grid_init_style = parse_B_ext_grid_function
warpx.E_ext_grid_init_style = parse_e_ext_grid_function
warpx.Bx_external_grid_function(x,y,z) = 0.0
warpx.By_external_grid_function(x,y,z) = cos(kz*z)
warpx.Bz_external_grid_function(x,y,z) = 0.0

# Diagnostics
diagnostics.diags_names = diag1
diag1.intervals  = 200
diag1.diag_type  = Full
diag1.fields_to_plot = Ex Ey Ez Bx By Bz
