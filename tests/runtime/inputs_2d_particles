# A run that asks for particles.  The particle-free build must refuse it with a message that
# names the switch, instead of failing somewhere in the first step.
#
# The geometry, the grid and the external field are the same as in inputs_2d on purpose:
# test_runtime_snapshot_2d checks the particle reduced diagnostics against values derived from
# exactly this deck (16x16 cells over [-1,1]^2, density 1e18 -> weight 1e18*0.015625 per
# particle, 256 macroparticles, rho = -q_e*1e18, cell-centre extrema +-0.9375), and the
# acceleration check needs a nonzero field to push the particles with.
max_step = 1
stop_time = 1.0e-9

amr.n_cell = 16 16
amr.max_grid_size = 16
amr.max_level = 0
geometry.dims = 2
geometry.prob_lo = -1.0 -1.0
geometry.prob_hi =  1.0  1.0

warpx.cfl = 0.4
algo.maxwell_solver = yee
algo.particle_shape = 1
boundary.field_lo = periodic periodic
boundary.field_hi = periodic periodic

warpx.E_ext_grid_init_style = parse_E_ext_grid_function
warpx.Ex_external_grid_function(x,y,z) = "1.0"
warpx.Ey_external_grid_function(x,y,z) = "0.0"
warpx.Ez_external_grid_function(x,y,z) = "0.0"

warpx.B_ext_grid_init_style = constant
warpx.B_external_grid = 0.0 1.0 0.0

particles.species_names = electrons
electrons.charge = -q_e
electrons.mass = m_e
electrons.injection_style = NUniformPerCell
electrons.num_particles_per_cell_each_dim = 1 1
electrons.profile = constant
electrons.density = 1.e18
electrons.momentum_distribution_type = constant
electrons.ux = 0.0
electrons.uy = 0.0
electrons.uz = 0.0

# Reduced diagnostics this deck is expected to produce; test_runtime_snapshot_2d reads them back.
warpx.reduced_diags_names = step_info lb_eff part_num part_energy part_mom rho_max extrema
step_info.type = Timestep
step_info.intervals = 1
lb_eff.type = LoadBalanceEfficiency
lb_eff.intervals = 1
part_num.type = ParticleNumber
part_num.intervals = 1
part_num.species = electrons
part_energy.type = ParticleEnergy
part_energy.intervals = 1
part_energy.species = electrons
part_mom.type = ParticleMomentum
part_mom.intervals = 1
part_mom.species = electrons
rho_max.type = RhoMaximum
rho_max.intervals = 1
extrema.type = ParticleExtrema
extrema.intervals = 1
extrema.species = electrons
