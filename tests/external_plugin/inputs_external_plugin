# Minimal 2D run used to prove that an out-of-repository plugin drives a real
# simulation: the plugin the test builds with a plain C compiler declares its own
# field state, registers a handler at a stage the core knows nothing about, and
# writes a named scalar.  The test asserts on the plugin's own output.
max_step = 3
stop_time = 1.0e-9

amr.n_cell = 16 16
amr.max_grid_size = 16
amr.max_level = 0
geometry.dims = 2
geometry.prob_lo = -1.0 -1.0
geometry.prob_hi =  1.0  1.0

warpx.cfl = 0.4
algo.maxwell_solver = yee
algo.particle_shape = 1
boundary.field_lo = periodic periodic
boundary.field_hi = periodic periodic

# one species so the kernel has particles to schedule around
particles.species_names = electrons
electrons.charge = -q_e
electrons.mass = m_e
electrons.injection_style = NUniformPerCell
electrons.num_particles_per_cell_each_dim = 1 1
electrons.profile = constant
electrons.density = 1.0e20
electrons.momentum_distribution_type = constant
electrons.ux = 0.0
electrons.uy = 0.0
electrons.uz = 0.0
